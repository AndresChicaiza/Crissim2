<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/homeFragment">

    <fragment
        android:id="@+id/homeFragment"
        android:name="com.example.crissim.presentation.ui.home.HomeFragment"
        android:label="@string/nav_home"
        tools:layout="@layout/fragment_home" />

    <fragment
        android:id="@+id/levelsFragment"
        android:name="com.example.crissim.presentation.ui.levels.LevelsFragment"
        android:label="@string/nav_levels"
        tools:layout="@layout/fragment_levels" />

    <fragment
        android:id="@+id/scenarioFragment"
        android:name="com.example.crissim.presentation.ui.scenario.ScenarioFragment"
        android:label="@string/scenario_screen_label"
        tools:layout="@layout/fragment_scenario">
        <argument
            android:name="scenarioId"
            app:argType="string" />
    </fragment>

    <!-- Estas dos siguen siendo marcadores de posición hasta que se construyan -->
    <fragment
        android:id="@+id/mapFragment"
        android:name="androidx.fragment.app.Fragment"
        android:label="@string/nav_map" />

    <fragment
        android:id="@+id/certificatesFragment"
        android:name="androidx.fragment.app.Fragment"
        android:label="@string/nav_certificates" />

</navigation>