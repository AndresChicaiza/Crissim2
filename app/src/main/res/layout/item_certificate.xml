<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="?attr/materialCardViewOutlinedStyle"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#0D4CAF50">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="Certificado"
                android:src="@android:drawable/ic_menu_agenda"
                app:tint="#2E7D32" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCertTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="#2E7D32"
                    android:textStyle="bold"
                    tools:text="Certificado Nivel Básico" />

                <TextView
                    android:id="@+id/tvCertUser"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    tools:text="Otorgado a: Juan Pérez (STUDENT_01)" />

            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/tvCertDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            tools:text="Puntaje: 100/100 · Firma QR: hash-abc-12345678" />

        <TextView
            android:id="@+id/tvCertDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="?android:attr/textColorSecondary"
            tools:text="Emitido el: 09/11/2026" />

        <!-- Botones de acción -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCertPreview"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="8dp"
                android:text="@string/certs_preview"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="#2E7D32"
                app:cornerRadius="8dp"
                app:icon="@android:drawable/ic_menu_view"
                app:iconGravity="start"
                app:iconSize="18dp"
                app:strokeColor="#2E7D32"
                app:strokeWidth="1.5dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCertShare"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/certs_share"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="#2E7D32"
                app:cornerRadius="8dp"
                app:icon="@android:drawable/ic_menu_share"
                app:iconGravity="start"
                app:iconSize="18dp"
                app:strokeColor="#2E7D32"
                app:strokeWidth="1.5dp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
