<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_pill_role"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top Bar: Title & Close -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:contentDescription="@string/micro_training_title"
                android:src="@drawable/ic_shield" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/micro_training_title"
                    android:textAppearance="?attr/textAppearanceTitleMedium"
                    android:textColor="@color/text_primary"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/micro_training_subtitle"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_dialog_streak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_role"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="🔥 Racha: 0 días"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="@color/primary"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Badges Bar -->
        <TextView
            android:id="@+id/tv_dialog_badges"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="🏆 Insignias: Ninguna aún"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/primary"
            android:textStyle="bold" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="#E2E8F0" />

        <!-- Question -->
        <TextView
            android:id="@+id/tv_dialog_question"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cargando pregunta de entrenamiento..."
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="@color/text_primary"
            android:textStyle="bold" />

        <!-- Options Container -->
        <RadioGroup
            android:id="@+id/rg_dialog_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

        <!-- Submit Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_dialog_submit"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="@color/primary"
            android:text="@string/micro_btn_submit"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="@color/surface_light"
            app:cornerRadius="12dp" />

        <!-- Feedback Area -->
        <LinearLayout
            android:id="@+id/layout_dialog_feedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_pill_role"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_dialog_feedback_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="¡Respuesta Registrada!"
                android:textAppearance="?attr/textAppearanceTitleSmall"
                android:textColor="@color/primary"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_dialog_explanation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Explicación técnica del protocolo..."
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:textColor="@color/text_secondary" />
        </LinearLayout>

        <!-- Close / Finish Dialog Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_dialog_close"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:text="Cerrar práctica"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="@color/primary"
            app:cornerRadius="10dp"
            app:strokeColor="@color/primary"
            app:strokeWidth="1dp" />

    </LinearLayout>
</ScrollView>
