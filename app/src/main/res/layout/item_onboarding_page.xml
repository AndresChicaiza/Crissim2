<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp">

    <!-- Imagen/Logo -->
    <ImageView
        android:id="@+id/ivOnboardingImage"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:scaleType="fitCenter"
        android:contentDescription="@string/onboarding_image_desc"
        tools:src="@drawable/ilc_logo" />

    <!-- Título -->
    <TextView
        android:id="@+id/tvOnboardingTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceHeadlineMedium"
        android:textColor="@color/text_primary"
        android:textStyle="bold"
        tools:text="@string/onboarding_page1_title" />

    <!-- Descripción -->
    <TextView
        android:id="@+id/tvOnboardingDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textColor="@color/text_secondary"
        android:lineSpacingExtra="4sp"
        tools:text="@string/onboarding_page1_description" />

    <!-- Botones -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="48dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="2">

        <!-- Botón Omitir -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOnboardingSkip"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/onboarding_skip"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="@color/text_secondary"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="12dp"
            app:rippleColor="@color/primary_10" />

        <!-- Botón Continuar / Finalizar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOnboardingNext"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="@string/onboarding_next"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            app:cornerRadius="12dp" />

    </LinearLayout>

</LinearLayout>